# BankSim Environment Configuration Example
# Copy this file to .env or backend/.env for local configuration

APP_NAME="BankSim: Blue-Team AI Firewall"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# Comma-separated or JSON list of permitted origins
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Simulated Banking SQLite Database Path (safe local development default)
DATABASE_URL="sqlite:///./backend/data/banksim.db"

# Authentication & JWT Configuration (Replace SECRET_KEY in production)
SECRET_KEY="banksim-dev-secret-key-replace-in-production-abcdef123456"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# Mandatory Login OTP Configuration
LOGIN_OTP_EXPIRE_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=3
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=30
LOGIN_OTP_MAX_RESENDS=3

# Adaptive Risk Engine Configuration
RISK_HIGH_AMOUNT_THRESHOLD_PAISE=5000000
RISK_VELOCITY_WINDOW_MINUTES=60
RISK_VELOCITY_TX_COUNT_THRESHOLD=3
RISK_BURST_WINDOW_SECONDS=60
RISK_BURST_REQUEST_COUNT_THRESHOLD=5
RISK_THRESHOLD_ALLOW=25
RISK_THRESHOLD_STEP_UP=60
RISK_THRESHOLD_RESTRICT=80

# AI Threat Analyzer Configuration
AI_PROVIDER="gemini"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=10.0
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=10.0
